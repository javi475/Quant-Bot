# ATE-SMP local development environment
# Copy to .env and fill in real values. Never commit .env.

# ===== Paths =====
ATE_SMP_HOME=/app
LOG_DIR=/var/log/ate-smp

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://ate_smp:ate_smp@postgres:5432/ate_smp
POSTGRES_USER=ate_smp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ate_smp

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== API Authentication =====
JWT_SECRET=replace_with_openssl_rand_hex_32
HERMES_HMAC_SECRET=replace_with_openssl_rand_hex_32
HERMES_HMAC_HEADER=X-Hermes-Signature
DASHBOARD_API_URL=http://backend:8000/api
ENGINE_API_URL=http://engine:9000/engine
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
TOTP_SECRET=replace_with_base32_secret

# ===== TradingView Webhook =====
TV_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_PRIORITY=info

# ===== Risk Defaults (DOC 4 §8) =====
RISK_KELLY_MULTIPLIER=0.25
RISK_MAX_RISK_PER_TRADE=0.02
RISK_DAILY_LOSS_BREAKER=-0.03
RISK_MAX_DRAWDOWN=0.15
RISK_MAX_CONCURRENT_POSITIONS=3
RISK_MAX_GROSS_EXPOSURE=0.60
RISK_CORRELATION_CAP=0.70
RISK_HEARTBEAT_TIMEOUT=300

# ===== Grafana (optional, --profile monitoring) =====
GRAFANA_PASSWORD=changeme
